# --- Gmail / Google OAuth (created by `gmail-manager auth`) ---
# OAuth 2.0 "Desktop app" client JSON downloaded from the Google Cloud console.
GMAIL_CREDENTIALS_FILE=credentials.json
# OAuth access/refresh token cache (written automatically on first auth).
GMAIL_TOKEN_FILE=token.json
GMAIL_USER_ID=me

# --- Classifier backend: "jev" (TypeSafe System One) or "llm" (OpenAI-compatible) ---
CLASSIFIER_BACKEND=jev

# --- Jev (TypeSafe AI) ---
# Early-access key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# --- Local LLM fallback (OpenAI-compatible endpoint, e.g. LiteLLM proxy) ---
# Used when CLASSIFIER_BACKEND=llm, or automatically when TYPESAFE_API_KEY is empty.
LLM_API_BASE=http://172.16.1.51:4000/v1
LLM_API_KEY=sk-placeholder-replace-me
LLM_MODEL=pegasus-lite
